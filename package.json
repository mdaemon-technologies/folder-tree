{
  "name": "@mdaemon/folder-tree",
  "version": "2.1.0",
  "description": "A zero-dependency TypeScript tree view component — drop-in jstree replacement, no jQuery required",
  "homepage": "https://github.com/mdaemon-technologies/folder-tree",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdaemon-technologies/folder-tree.git"
  },
  "bugs": {
    "url": "https://github.com/mdaemon-technologies/folder-tree/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./dist/styles.css": "./dist/styles.css",
    "./umd": "./dist/MDFolderTree.umd.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scripts/migrate-from-jstree.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build --mode production && vite build --mode umd",
    "build:dev": "vite build --mode development",
    "build:umd": "vite build --mode umd",
    "dev": "vite build --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolated": "vitest run --isolate",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node smoke/smoke.test.codemod.cjs && node smoke/smoke.test.cjs && node smoke/smoke.test.mjs && node smoke/smoke.test.umd.cjs",
    "lint": "eslint src",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit && node node_modules/@typescript/native/bin/tsc -p tsconfig.test.json --noEmit",
    "demo": "vite demo"
  },
  "keywords": [
    "tree",
    "treeview",
    "folder-tree",
    "jstree",
    "jstree-replacement",
    "zero-dependency",
    "typescript",
    "checkbox-tree"
  ],
  "author": {
    "name": "MDaemon Technologies, Ltd.",
    "email": "jonathan.ehman@mdaemon.com",
    "url": "https://www.mdaemon.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.10.0",
    "jsdom": "^31.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^5.1.1"
  }
}
