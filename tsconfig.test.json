{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "esModuleInterop": true,
    // The base config's rootDir is ./src; the tests live beside it.
    "rootDir": "."
  },
  "include": ["src", "__tests__"],
  // Replaces the base config's exclude, which lists __tests__: inherited, it
  // would leave every test out of `npm run typecheck`.
  "exclude": ["node_modules", "dist"]
}
